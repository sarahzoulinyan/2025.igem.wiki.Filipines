    <script type="module">
        class CanvasScrollClip {
            constructor(container, options) {
                this.container = container;
                this.options = options;
                this.currentFrame = 0;
                this.images = [];
                this.canvas = document.createElement('canvas');
                this.context = this.canvas.getContext('2d');
                this.loadedCount = 0;
                this.failedImages = [];
                this.frameFormats = {}; // Store the format for each frame
                
                // Add sticky first frame configuration
                this.firstFrameStickiness = options.firstFrameStickiness || 0.1;
                
                // Create wrapper div for sticky positioning
                this.canvasWrapper = document.createElement('div');
                this.canvasWrapper.className = 'canvas-wrapper';
                
                // Set up canvas with proper centering
                this.canvasWrapper.appendChild(this.canvas);
                this.container.appendChild(this.canvasWrapper);
                
                // Style canvas for proper centering
                this.canvas.style.maxWidth = '100%';
                this.canvas.style.height = 'auto';
                this.canvas.style.display = 'block';
                this.canvas.style.margin = '0 auto';
                
                // Create scroll area
                const scrollArea = document.createElement('div');
                scrollArea.style.height = `${options.scrollArea || 8000}px`;
                this.container.appendChild(scrollArea);
                
                // Initialize
                this.init();
            }
            
            async init() {
                console.log('Starting initialization...');
                const success = await this.loadImages();
                
                if (success && this.images.length > 0) {
                    this.setupCanvas();
                    this.updateCanvas(0);
                    this.addEventListeners();
                } else {
                    this.showError();
                }
            }
            
            setupCanvas() {
                const firstLoadedImage = this.images.find(img => img !== undefined);
                if (firstLoadedImage) {
                    // Set the actual canvas resolution to match the image
                    this.canvas.width = firstLoadedImage.width;
                    this.canvas.height = firstLoadedImage.height;
                    
                    // Calculate the display size to fit within viewport while maintaining aspect ratio
                    const aspectRatio = firstLoadedImage.width / firstLoadedImage.height;
                    const maxHeight = window.innerHeight * 0.8;
                    const maxWidth = Math.min(window.innerWidth * 0.9, 1200);
                    
                    let displayWidth, displayHeight;
                    
                    // Calculate dimensions to contain the full image
                    if (maxWidth / maxHeight > aspectRatio) {
                        displayHeight = maxHeight;
                        displayWidth = displayHeight * aspectRatio;
                    } else {
                        displayWidth = maxWidth;
                        displayHeight = displayWidth / aspectRatio;
                    }
                    
                    // Apply calculated dimensions
                    this.canvas.style.width = `${displayWidth}px`;
                    this.canvas.style.height = `${displayHeight}px`;
                    
                    // Store for responsive updates
                    this.aspectRatio = aspectRatio;
                }
            }
            
            async loadImages() {
                const loadingOverlay = document.getElementById('loadingOverlay');
                const progressBar = document.getElementById('progressBar');
                const loadingStatus = document.getElementById('loadingStatus');
                
                const startFrame = this.options.startFrame !== undefined ? this.options.startFrame : 0;
                
                console.log(`Attempting to load ${this.options.frameCount} frames...`);
                console.log(`Base URL: ${this.options.baseUrl}`);
                console.log(`Starting from frame: ${startFrame}`);
                
                // Load all frames
                const loadPromises = [];
                
                for (let i = 0; i < this.options.frameCount; i++) {
                    const frameNumber = String(i + startFrame).padStart(this.options.padLength || 6, '0');
                    loadPromises.push(this.loadSingleFrame(frameNumber, i));
                }
                
                // Wait for all images to load or fail
                const results = await Promise.allSettled(loadPromises);
                
                // Process results
                results.forEach((result, index) => {
                    if (result.status === 'fulfilled' && result.value) {
                        this.images[index] = result.value;
                        this.loadedCount++;
                    } else {
                        this.failedImages.push(index + startFrame);
                    }
                    
                    const progress = ((index + 1) / this.options.frameCount) * 100;
                    if (progressBar) {
                        progressBar.style.width = `${progress}%`;
                    }
                    if (loadingStatus) {
                        loadingStatus.textContent = `Loading frame ${index + 1} of ${this.options.frameCount}`;
                    }
                });
                
                console.log(`Loaded ${this.loadedCount} out of ${this.options.frameCount} frames`);
                if (this.failedImages.length > 0) {
                    console.warn(`Failed to load frames: ${this.failedImages.join(', ')}`);
                }
                
                // Hide loading overlay
                if (loadingOverlay) {
                    setTimeout(() => {
                        loadingOverlay.classList.add('loaded');
                    }, 500);
                }
                
                // Return success if we loaded at least 50% of frames
                return this.loadedCount >= this.options.frameCount * 0.5;
            }
            
            async loadSingleFrame(frameNumber, index) {
                // Try both .webp and .avif formats
                const formats = this.options.formats || ['webp', 'avif'];
                
                for (const format of formats) {
                    const url = `${this.options.baseUrl}frame-${frameNumber}.${format}`;
                    const result = await this.loadSingleImage(url, index);
                    
                    if (result) {
                        this.frameFormats[index] = format;
                        console.log(`Loaded frame ${index} as ${format}`);
                        return result;
                    }
                }
                
                console.warn(`Failed to load frame ${index} in any format`);
                return null;
            }
            
            loadSingleImage(url, frameNumber) {
                return new Promise((resolve) => {
                    const img = new Image();
                    img.crossOrigin = 'anonymous';
                    
                    const timeout = setTimeout(() => {
                        resolve(null);
                    }, 10000); // 10 second timeout per image
                    
                    img.onload = () => {
                        clearTimeout(timeout);
                        resolve(img);
                    };
                    
                    img.onerror = () => {
                        clearTimeout(timeout);
                        resolve(null);
                    };
                    
                    img.src = url;
                });
            }
            
            showError() {
                const errorDiv = document.createElement('div');
                errorDiv.className = 'error-message';
                errorDiv.innerHTML = `
                    <h2>Animation Loading Error</h2>
                    <p>Unable to load enough animation frames. This might be due to:</p>
                    <ul>
                        <li>Images not available at the expected URLs</li>
                        <li>Network connectivity issues</li>
                        <li>CORS restrictions</li>
                    </ul>
                    <p style="margin-top: 1rem;">Successfully loaded: ${this.loadedCount}/${this.options.frameCount} frames</p>
                    <p style="margin-top: 0.5rem; font-size: 0.9rem; opacity: 0.7;">
                        Attempted formats: ${(this.options.formats || ['webp', 'avif']).join(', ')}
                    </p>
                `;
                
                // Clear container and show error
                this.container.innerHTML = '';
                this.container.appendChild(errorDiv);
                
                // Still create scroll area for layout
                const scrollArea = document.createElement('div');
                scrollArea.style.height = `${this.options.scrollArea || 8000}px`;
                this.container.appendChild(scrollArea);
            }
            
            addEventListeners() {
                window.addEventListener('scroll', () => {
                    this.handleScroll();
                });
                
                window.addEventListener('resize', () => {
                    this.setupCanvas();
                    this.updateCanvas(this.currentFrame);
                });
            }
            
            handleScroll() {
                const scrollTop = window.pageYOffset;
                const containerTop = this.container.offsetTop;
                const containerHeight = this.options.scrollArea || 8000;
                
                // Calculate raw scroll progress relative to the animation container
                const rawScrollProgress = Math.max(0, Math.min(1, 
                    (scrollTop - containerTop + window.innerHeight) / containerHeight
                ));
                
                // Apply sticky first frame logic
                let adjustedScrollProgress;
                
                if (rawScrollProgress < this.firstFrameStickiness) {
                    // Keep showing frame 0 while in the sticky zone
                    adjustedScrollProgress = 0;
                } else {
                    // Remap the remaining scroll range (after sticky zone) to 0-1
                    adjustedScrollProgress = (rawScrollProgress - this.firstFrameStickiness) / (1 - this.firstFrameStickiness);
                }
                
                const frameIndex = Math.min(
                    Math.floor(adjustedScrollProgress * this.options.frameCount),
                    this.options.frameCount - 1
                );
                
                if (frameIndex !== this.currentFrame && frameIndex >= 0) {
                    this.currentFrame = frameIndex;
                    this.updateCanvas(frameIndex);
                    
                    // Optional: Log frame changes for debugging
                    if (frameIndex === 0) {
                        console.log('Showing first frame (sticky)');
                    } else {
                        console.log(`Frame changed to: ${frameIndex}`);
                    }
                }
            }
            
            updateCanvas(frameIndex) {
                // Find the nearest loaded frame if current frame failed to load
                let actualFrame = frameIndex;
                let searchRadius = 0;
                
                while (!this.images[actualFrame] && searchRadius < this.images.length) {
                    searchRadius++;
                    
                    // Check frames before and after
                    if (frameIndex - searchRadius >= 0 && this.images[frameIndex - searchRadius]) {
                        actualFrame = frameIndex - searchRadius;
                        break;
                    }
                    if (frameIndex + searchRadius < this.images.length && this.images[frameIndex + searchRadius]) {
                        actualFrame = frameIndex + searchRadius;
                        break;
                    }
                }
                
                if (this.images[actualFrame]) {
                    this.context.clearRect(0, 0, this.canvas.width, this.canvas.height);
                    this.context.drawImage(this.images[actualFrame], 0, 0, this.canvas.width, this.canvas.height);
                }
            }
        }
        
        document.addEventListener('DOMContentLoaded', () => {
            const secondAnimationContainer = document.getElementById('secondAnimationContainer');
            
            // Configuration for the new frame structure
            new CanvasScrollClip(secondAnimationContainer, {
                baseUrl: 'https://static.igem.wiki/teams/5717/hardware/frame/',
                frameCount: 315,  
                scrollArea: 8000,
                padLength: 6,
                startFrame: 0,
                formats: ['webp', 'avif'],  
                firstFrameStickiness: 0.15  
            });
        });
    </script>

