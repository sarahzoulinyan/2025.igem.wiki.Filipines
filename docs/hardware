                    img.src = url;
                });
            }
            
            showError() {
                const errorDiv = document.createElement('div');
                errorDiv.className = 'error-message';
                errorDiv.style.textAlign = 'center';
                errorDiv.style.padding = '2rem';
                errorDiv.innerHTML = `
                    <h2>Animation Loading Error</h2>
                    <p>Unable to load the scroll animation frames. This might be due to:</p>
                    <ul style="text-align: left; display: inline-block; margin-top: 1rem;">
                        <li>Images not available at the expected URLs</li>
                        <li>Network connectivity issues</li>
                        <li>CORS restrictions</li>
                    </ul>
                    <p style="margin-top: 1rem;">Loaded: ${this.loadedCount}/${this.options.frameCount} frames</p>
                `;
                
                // Clear container and show error
                this.container.innerHTML = '';
                this.container.appendChild(errorDiv);
                
                // Still create scroll area for layout
                const scrollArea = document.createElement('div');
                scrollArea.style.height = `${this.options.scrollArea || 2000}px`;
                this.container.appendChild(scrollArea);
            }
            
            addEventListeners() {
                window.addEventListener('scroll', () => {
                    this.handleScroll();
                });
                
                window.addEventListener('resize', () => {
                    this.setupCanvas();
                    this.updateCanvas(this.currentFrame);
                });
            }
            
            handleScroll() {
                const scrollTop = window.pageYOffset;
                const containerTop = this.container.offsetTop;
                const containerHeight = this.options.scrollArea || 2000;
                
                const scrollProgress = Math.max(0, Math.min(1, 
                    (scrollTop - containerTop + window.innerHeight) / containerHeight
                ));
                
                const frameIndex = Math.min(
                    Math.floor(scrollProgress * this.options.frameCount),
                    this.options.frameCount - 1
                );
                
                if (frameIndex !== this.currentFrame && frameIndex >= 0) {
                    this.currentFrame = frameIndex;
                    this.updateCanvas(frameIndex);
                }
            }
            
            updateCanvas(frameIndex) {
                // Find the nearest loaded frame if current frame failed to load
                let actualFrame = frameIndex;
                let searchRadius = 0;
                
                while (!this.images[actualFrame] && searchRadius < this.images.length) {
                    searchRadius++;
                    
                    // Check frames before and after
                    if (frameIndex - searchRadius >= 0 && this.images[frameIndex - searchRadius]) {
                        actualFrame = frameIndex - searchRadius;
                        break;
                    }
                    if (frameIndex + searchRadius < this.images.length && this.images[frameIndex + searchRadius]) {
                        actualFrame = frameIndex + searchRadius;
                        break;
                    }
                }
                
                if (this.images[actualFrame]) {
                    this.context.clearRect(0, 0, this.canvas.width, this.canvas.height);
                    this.context.drawImage(this.images[actualFrame], 0, 0, this.canvas.width, this.canvas.height);
                }
            }
        }
        
        document.addEventListener('DOMContentLoaded', () => {
            const animationContainer = document.getElementById('animationContainer');
            
