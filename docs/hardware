    <script>
        document.addEventListener('DOMContentLoaded', () => {
        const slideshowContainer = document.querySelector('.slideshow-container');
        const overlayContainer = document.getElementById('overlayContainer');
        const overlayImages = document.querySelectorAll('.overlay-image');
        
        if (!overlayContainer || !slideshowContainer) return;
        
        // Create scroll spacer
        const scrollSpacer = document.createElement('div');
        scrollSpacer.className = 'slideshow-scroll-spacer';
        slideshowContainer.appendChild(scrollSpacer);
        
        const config = {
            startDelay: 0.08,      
            fadeInDuration: 0.02,   
            holdDuration: 0.05,     
            fadeOutDuration: 0.01,  
            gapBetweenImages: 0.01, 
            endBuffer: 0.04         
        };
        
        // Calculate total duration per slide
        const totalPerSlide = config.fadeInDuration + config.holdDuration + config.fadeOutDuration + config.gapBetweenImages;
        const imageCount = overlayImages.length;
        const totalTimelineLength = config.startDelay + (imageCount * totalPerSlide);
        const scaleFactor = Math.min(1, (1 - config.endBuffer) / totalTimelineLength);
        
        // Build timeline
        const imageTimeline = [];
        for (let i = 0; i < imageCount; i++) {
            const baseStart = config.startDelay + (i * totalPerSlide * scaleFactor);
            imageTimeline.push({
                element: overlayImages[i],
                fadeInStart: baseStart,
                fadeInEnd: baseStart + (config.fadeInDuration * scaleFactor),
                holdStart: baseStart + (config.fadeInDuration * scaleFactor),
                holdEnd: baseStart + ((config.fadeInDuration + config.holdDuration) * scaleFactor),
                fadeOutStart: baseStart + ((config.fadeInDuration + config.holdDuration) * scaleFactor),
                fadeOutEnd: baseStart + ((config.fadeInDuration + config.holdDuration + config.fadeOutDuration) * scaleFactor)
            });
        }
        
        function calculateOpacity(progress, timeline) {
            // Before fade in
            if (progress < timeline.fadeInStart) {
                return 0;
            }
            // During fade in - sharp transition
            else if (progress < timeline.fadeInEnd) {
                const fadeProgress = (progress - timeline.fadeInStart) / (timeline.fadeInEnd - timeline.fadeInStart);
                // Use an easing function for snappier feel
                return Math.pow(fadeProgress, 0.5); // Quick ease-in
            }
            // During hold - stable viewing zone
            else if (progress < timeline.holdEnd) {
                return 1;
            }
            // During fade out - sharp transition
            else if (progress < timeline.fadeOutEnd) {
                const fadeProgress = (progress - timeline.fadeOutStart) / (timeline.fadeOutEnd - timeline.fadeOutStart);
                // Use an easing function for snappier feel
                return Math.pow(1 - fadeProgress, 0.5); // Quick ease-out
            }
            // After fade out
            else {
                return 0;
            }
        }
        
        // Track current slide for snap behavior
        let currentSlide = -1;
        
        function handleSlideshowScroll() {
            const containerTop = slideshowContainer.offsetTop;
            const scrollTop = window.pageYOffset;
            const windowHeight = window.innerHeight;
            const containerHeight = scrollSpacer.offsetHeight;
            
            const scrollProgress = Math.max(0, Math.min(1, 
                (scrollTop - containerTop + windowHeight) / containerHeight
            ));
            
            // Check if scrolled past
            const containerBottom = containerTop + containerHeight;
            const hasScrolledPast = scrollTop > containerBottom;
            
            if (hasScrolledPast) {
                overlayContainer.style.visibility = 'hidden';
                overlayContainer.style.pointerEvents = 'none';
                return;
            }
            
            overlayContainer.style.visibility = 'visible';
            overlayContainer.style.pointerEvents = 'none';
            
            // Find which slide we're closest to for snap effect
            let activeSlide = -1;
            for (let i = 0; i < imageTimeline.length; i++) {
                const slideCenter = (imageTimeline[i].fadeInStart + imageTimeline[i].holdEnd) / 2;
                if (scrollProgress >= slideCenter - (totalPerSlide * scaleFactor / 2) && 
                    scrollProgress <= slideCenter + (totalPerSlide * scaleFactor / 2)) {
                    activeSlide = i;
                    break;
                }
            }
            
            // Update opacities with enhanced visibility for active slide
            imageTimeline.forEach((item, index) => {
                if (item.element) {
                    let opacity = calculateOpacity(scrollProgress, item);
                    
                    // Boost opacity for the active slide (snap effect)
                    if (index === activeSlide && opacity > 0.3) {
                        opacity = 1;
                    }
                    // Reduce opacity for non-active slides
                    else if (index !== activeSlide && opacity > 0 && opacity < 1) {
                        opacity = opacity * 0.8;
                    }
                    
                    item.element.style.opacity = opacity;
                    // Faster transition for snappier feel
                    item.element.style.transition = 'opacity 0.1s ease-out';
                }
            });
            
            // Update current slide tracker
            if (activeSlide !== currentSlide) {
                currentSlide = activeSlide;
            }
        }
        
        // Initialize
        window.addEventListener('scroll', handleSlideshowScroll);
        handleSlideshowScroll();
    });
    </script>
