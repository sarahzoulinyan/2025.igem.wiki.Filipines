            const slider = document.querySelector('.button-slider');

            // Function to update slider position
            function updateSliderPosition(activeButton) {
                if (!activeButton || !slider) return;
                
                const containerRect = activeButton.parentElement.getBoundingClientRect();
                const buttonRect = activeButton.getBoundingClientRect();
                
                const left = buttonRect.left - containerRect.left;
                const width = buttonRect.width;
                
                slider.style.left = `${left}px`;
                slider.style.width = `${width}px`;
            }

            // Initialize slider position
            setTimeout(() => {
                const initialActiveButton = document.querySelector('.variant-button.active');
                updateSliderPosition(initialActiveButton);
            }, 100);

            // Add click event to each button
            buttons.forEach(button => {
                button.addEventListener('click', () => {
                    // Get the variant from data attribute
                    const targetVariant = button.getAttribute('data-variant');
                    
                    // Remove active class from all buttons and sections
                    buttons.forEach(btn => btn.classList.remove('active'));
                    sections.forEach(section => section.classList.remove('active'));
                    
                    // Add active class to clicked button
                    button.classList.add('active');
                    
                    // Update slider position
                    updateSliderPosition(button);
                    
                    // Show the corresponding section
                    const targetSection = document.getElementById(targetVariant);
